{
  "name": "web-xiangqi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "description": "Fast browser Xiangqi analysis board powered by Pikafish WASM",
  "main": "dist/pikafish.js",
  "scripts": {
    "dev": "vite",
    "build:react": "node scripts/clean-react-dist.cjs && tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "build": "bash scripts/build-pikafish.sh",
    "test:smoke": "node scripts/test-smoke.cjs threaded",
    "test:smoke:single": "node scripts/test-smoke.cjs single",
    "test:smoke:all": "node scripts/test-smoke.cjs threaded && node scripts/test-smoke.cjs single",
    "serve:demo": "node scripts/serve-demo.cjs",
    "test:parity": "node scripts/test-parity.cjs single",
    "test:worker-parity:browser": "node scripts/test-worker-parity-browser.cjs",
    "test:review:fixtures": "node scripts/test-review-fixtures-browser.cjs",
    "test:review:browser": "node scripts/test-review-browser.cjs",
    "test:review:parity": "node scripts/test-review-parity.cjs",
    "test:ui:install": "playwright install chromium",
    "test:ui:layout": "node scripts/test-ui-layout.cjs",
    "test:openings": "node scripts/test-openings.cjs",
    "test:library": "node scripts/test-library.cjs",
    "test:serve-demo": "node scripts/test-serve-demo.cjs",
    "test:bench:quick": "node scripts/bench-nps.cjs --variant single-simd --depth 3 --repeats 1 --warmup 0 --hash 16 --threads 1 --quiet --json",
    "bench:nps": "node scripts/bench-nps.cjs",
    "bench:nps:threaded-simd": "node scripts/bench-nps.cjs --variant threaded-simd"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "playwright": "^1.60.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.11"
  }
}
